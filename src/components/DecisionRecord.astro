---
import StatusLabel from './StatusLabel.astro';

type StatusValue = 'proposed' | 'agreed' | 'published' | 'implemented' | 'unverified';

interface Props {
  decision: string;
  evidence: string;
  constraint: string;
  direction: string;
  status: StatusValue;
}

const { decision, evidence, constraint, direction, status } = Astro.props;

const toneByStatus: Record<StatusValue, 'verified' | 'progress' | 'placeholder'> = {
  proposed: 'placeholder',
  agreed: 'progress',
  published: 'verified',
  implemented: 'verified',
  unverified: 'placeholder',
};

const statusLabel = status.charAt(0).toUpperCase() + status.slice(1);
---

<article class="decision-record" aria-label={`Decision record: ${decision}`}>
  <header class="decision-record__header">
    <p class="decision-record__eyebrow">Decision record</p>
    <StatusLabel label={statusLabel} tone={toneByStatus[status]} />
  </header>
  <dl class="decision-record__grid">
    <div class="decision-record__row">
      <dt>Decision</dt>
      <dd>{decision}</dd>
    </div>
    <div class="decision-record__row">
      <dt>Evidence</dt>
      <dd>{evidence}</dd>
    </div>
    <div class="decision-record__row">
      <dt>Constraint</dt>
      <dd>{constraint}</dd>
    </div>
    <div class="decision-record__row">
      <dt>Direction</dt>
      <dd>{direction}</dd>
    </div>
  </dl>
</article>

<style>
  .decision-record {
    border: var(--border-thin);
    border-left: 4px solid var(--color-blue);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: var(--space-3);
  }

  .decision-record__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-wrap: wrap;
  }

  .decision-record__eyebrow {
    font-size: var(--step-meta);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
  }

  .decision-record__grid {
    display: grid;
    gap: var(--space-2);
  }

  .decision-record__row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-2);
    padding-block: var(--space-1);
    border-top: 1px solid var(--color-border);
  }

  .decision-record__row:first-child {
    border-top: none;
  }

  .decision-record__row dt {
    font-weight: 700;
    font-size: var(--step-meta);
    color: var(--color-text);
  }

  .decision-record__row dd {
    margin: 0;
    color: var(--color-text-secondary);
  }

  @media (max-width: 599px) {
    .decision-record__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
